# Copy to backend/.env and fill in. Never commit the real .env.

PORT=4000
# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:5173

# Supabase project settings -> API. The service role key must stay on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key for AI suggestions. Leave empty to run with manual entry only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Turn AI response on (true) or off (false) to test manual entry
ENABLE_AI=true

# Optional: Claude API key (alternative fallback if configured)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional: Campus Security phone number shown on the emergency screen. Defaults to "ext. 2222 or (555) 019-9111"
CAMPUS_SECURITY_PHONE=

# Long random string used to sign AI suggestions, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUGGESTION_SECRET=
