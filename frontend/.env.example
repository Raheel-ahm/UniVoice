# Copy to .env.local (in the project root) and fill in.

# Supabase project settings -> API. Use the public anon key, never the service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Leave empty in development (Vite proxies /api to localhost:4000).
# In production, set to the backend's URL, e.g. https://api.univoice.example.edu
VITE_API_URL=

